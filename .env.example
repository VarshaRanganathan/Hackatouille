# Supabase project URL, for example:
# https://your-project-ref.supabase.co
SUPABASE_URL=

# Server-side Supabase key. The current backend creates and removes managed
# users, so use a key with the required server privileges. Never expose this
# value in frontend code or commit a populated .env file.
SUPABASE_KEY=

# Long random string used to sign the active-user HTTP-only session cookie.
# Generate one locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Most hosting platforms inject PORT automatically.
PORT=3000